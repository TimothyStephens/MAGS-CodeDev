#!/usr/bin/env bash
set -euo pipefail

# ── Config ────────────────────────────────────────────────────────────
SESSION_PREFIX="omp"
PODMAN_IMAGE="localhost/mags-codedev-omp"
PODMAN_TAG="latest"
MONITOR_INTERVAL=5
MODELS_FILE="$HOME/.omp/agent/models.yml"
EXTRA_PODMAN_PARAMETERS="--privileged --security-opt seccomp=unconfined --security-opt apparmor=unconfined -v /sys/fs/cgroup:/sys/fs/cgroup:ro"

# ── Helpers ───────────────────────────────────────────────────────────
die()  { echo "Error: $*" >&2; exit 1; }
ok()   { echo "  ✓ $*"; }
warn() { echo "  ⚠ $*" >&2; }
fail() { echo "  ✗ $*" >&2; }

# List active OMP sessions robustly (exact prefix match, not substring).
active_sessions() {
    tmux list-sessions -F '#{session_name}' 2>/dev/null \
        | grep -E "^${SESSION_PREFIX}(-[0-9]+)?$" || true
}

# Count active sessions (integer-safe, no leading whitespace).
session_count() {
    local n
    n=$(active_sessions | wc -l)
    echo "${n// /}"
}

image_ref() {
    echo "${PODMAN_IMAGE}:${PODMAN_TAG}"
}

# ── Preflight: check models.yml ──────────────────────────────────────
check_models_config() {
    if [ ! -f "$MODELS_FILE" ]; then
        die "No models config at $MODELS_FILE"
    fi
    ok "Models config: $MODELS_FILE"
}

# ── Preflight: extract baseUrls from models.yml ──────────────────────
extract_endpoints() {
    grep 'baseUrl:' "$MODELS_FILE" | sed 's/.*baseUrl: *//; s/^"//; s/"$//' | sort -u
}

# ── Preflight: ping an endpoint ──────────────────────────────────────
ping_endpoint() {
    local url="$1"
    url="${url%/}"
    local code

    # Try {url}/models first (works if url ends with /v1)
    code=$(curl -sf -o /dev/null -w "%{http_code}" \
        --connect-timeout 3 --max-time 5 \
        "${url}/models" 2>/dev/null) || code="000"

    # If that failed, try with /v1 prefix
    if [ "$code" = "000" ]; then
        code=$(curl -sf -o /dev/null -w "%{http_code}" \
            --connect-timeout 3 --max-time 5 \
            "${url}/v1/models" 2>/dev/null) || code="000"
    fi

    if [ "$code" = "200" ]; then
        ok "  ${url}  →  HTTP ${code}"
        return 0
    elif [ "$code" = "401" ] || [ "$code" = "403" ]; then
        ok "  ${url}  →  HTTP ${code} (up, auth required)"
        return 0
    else
        fail "  ${url}  →  HTTP ${code}"
        return 1
    fi
}

# ── Preflight: check all endpoints (opt-in via --check-hosts) ────────
check_endpoints() {
    local endpoints
    endpoints=$(extract_endpoints)

    if [ -z "$endpoints" ]; then
        warn "No endpoints found in models config"
        return 0
    fi

    echo ""
    echo "Checking local model servers..."
    echo ""

    local failed=0
    while IFS= read -r ep; do
        [ -z "$ep" ] && continue
        if ! ping_endpoint "$ep"; then
            failed=$((failed + 1))
        fi
    done <<< "$endpoints"

    echo ""

    if [ "$failed" -gt 0 ]; then
        fail "$failed endpoint(s) unreachable."
        echo "  Continuing anyway (host checks are opt-in)."
    else
        ok "All endpoints reachable"
    fi
}

create_session() {
    local project_dir="${1:-.}"
    project_dir=$(realpath "$project_dir" 2>/dev/null || echo "$project_dir")
    [ -d "$project_dir" ] || die "Not a directory: $project_dir"

    local image=$(image_ref)

    # Session name: find the next available number (handles gaps from kills).
    local name=""
    local i=1
    while true; do
        local candidate="${SESSION_PREFIX}-${i}"
        if ! tmux has-session -t "$candidate" 2>/dev/null; then
            name="$candidate"
            break
        fi
        i=$((i + 1))
    done

    # OMP config mount
    local omp_flag="-v ${project_dir}:/workspace:z"
    if [ -d "$HOME/.omp" ]; then
        omp_flag="${omp_flag} -v $(realpath "$HOME/.omp"):/root/.omp:z"
    fi

    echo ""
    echo "Creating ${name} → ${project_dir} [${image}]"
    echo ""

    # ── Start container in detached mode ─────────────────────────────
    # Container stays alive via 'sleep infinity'; panes connect via
    # podman exec -it, so each gets its own interactive session.
    podman run ${EXTRA_PODMAN_PARAMETERS} \
        --name "${name}" --entrypoint "" \
        --replace -d --network=host ${omp_flag} \
        ${image} sleep infinity

    # Wait until the container is actually running
    local wait_count=0
    while [ $wait_count -lt 30 ]; do
        if podman ps --format '{{.Names}}' | grep -q "^${name}$"; then
            break
        fi
        sleep 0.5
        wait_count=$((wait_count + 1))
    done
    podman ps --format '{{.Names}}' | grep -q "^${name}$" \
        || die "Container ${name} did not start"

    # ── Layout ────────────────────────────────────────────────────────
    # Three columns: OMP (left, full height) | shells (middle) | tools (right)
    #
    # ┌──────────────────────────┬──────────┬──────────┐
    # │                          │ Shell 1  │          │
    # │  OMP (agent)             ├──────────┤  btop    │
    # │  ~58%                    │ Shell 2  ├──────────┤
    # │                          │          │ Monitor  │
    # └──────────────────────────┴──────────┴──────────┘

    # Pane 0: OMP — start a shell in the tmux pane, then exec omp inside container
    tmux new-session -d -s "$name" -c "$project_dir" "bash"

    # Send 'omp' command via podman exec to the container
    tmux send-keys -t "${name}:0.0" \
        "podman exec -it ${name} bash -lc 'omp'" Enter

    # ── Build pane layout ──────────────────────────────────────────────
    # Strategy: create 3 equal columns, then split middle+right for rows
    # Finally swap panes to get correct program assignments

    # Create 3 columns (even-horizontal makes them equal width)
    tmux split-window -dh -t "${name}:0.0"   # pane 1
    tmux split-window -dh -t "${name}:0.1"   # pane 2
    tmux select-layout -t "${name}:0" even-horizontal
    # Columns: 0=OMP, 1=middle, 2=right (all equal ~33%)

    # Split RIGHT column first: top (btop) / bottom (new pane 3)
    tmux select-pane -t "${name}:0.2"
    tmux split-window -v -t "${name}:0.2"
    # Now: 0=OMP, 1=middle(full), 2=btop(top-right), 3=Monitor(bot-right)

    # Split MIDDLE column: top (Shell 1) / bottom (new pane 4)
    tmux select-pane -t "${name}:0.1"
    tmux split-window -v -t "${name}:0.1"
    # Now: 0=OMP, 1=Shell1, 2=btop, 3=Monitor, 4=Shell2

    # ── Resize columns ─────────────────────────────────────────────────
    local cols
    cols=$(tmux display-message -t "${name}:0.0" -p '#{window_width}')

    local col_left=$((cols * 58 / 100))
    local col_mid=$((cols * 21 / 100))
    local col_right=$((cols - col_left - col_mid))

    # Resize left column
    tmux resize-pane -t "${name}:0.0" -x "${col_left}"
    # Resize middle column (panes 1, 2)
    tmux resize-pane -t "${name}:0.1" -x "${col_mid}"
    tmux resize-pane -t "${name}:0.2" -x "${col_mid}"
    # Resize right column (panes 3, 4)
    tmux resize-pane -t "${name}:0.3" -x "${col_right}"
    tmux resize-pane -t "${name}:0.4" -x "${col_right}"

    # ── Start programs ─────────────────────────────────────────────────
    # Pane 1: Shell 1 — interactive shell inside the container
    tmux send-keys -t "${name}:0.1" \
        "podman exec -it ${name} env PROMPT_COMMAND='clear; unset PROMPT_COMMAND' bash" Enter
    # Pane 2: Shell 2 — second interactive shell inside the container
    tmux send-keys -t "${name}:0.2" \
        "podman exec -it ${name} env PROMPT_COMMAND='clear; unset PROMPT_COMMAND' bash" Enter
    # Pane 3: btop (top-right) — host resource monitor
    tmux send-keys -t "${name}:0.3" "btop 2>/dev/null || htop" Enter
    # Pane 4: Monitor (bottom-right) — git status + podman ps
    tmux send-keys -t "${name}:0.4" \
        "watch -n ${MONITOR_INTERVAL} -t 'echo \"=== Podman ===\"; podman ps --format \"{{.Names}} {{.Status}}\" 2>/dev/null | head -20; echo; echo \"=== Git ===\"; git -C ${project_dir} status --short 2>/dev/null || echo \"no repo\"'" \
        Enter

    # Select OMP pane
    tmux select-pane -t "${name}:0.0"

    tmux attach -t "$name"
}

# ── List sessions ────────────────────────────────────────────────────
show_list() {
    local list=$(active_sessions)
    if [ -z "$list" ]; then
        echo "No active sessions."
    else
        echo "Active sessions:"
        echo "$list"
    fi
}

# ── Kill session (and its podman container) ──────────────────────────
kill_session() {
    local target="${1:?Session name required}"
    tmux kill-session -t "$target" 2>/dev/null || die "Not found: $target"
    # Also stop the podman container if it's still running
    podman stop "$target" 2>/dev/null || true
    podman rm "$target" 2>/dev/null || true
    echo "Killed: $target"
}

# ── Help ─────────────────────────────────────────────────────────────
show_help() {
    cat << 'EOF'
omp-workspace  —  tmux manager for OMP + podman sandbox

USAGE
    omp-workspace [OPTIONS] [DIRECTORY]

OPTIONS
    --help, -h                 This help
    --list, -l                 Active sessions
    --continue, -c             Attach to existing (default)
    --new, -n                  Create new session
    --check-hosts              Ping model server endpoints before starting
    --kill, -k NAME            Kill session (also stops its podman container) 
    --attach, -a NAME          Attach to a specific session by name
    --extra_podman_params, -e  Extra parameters for podman

LAYOUT
    ┌──────────────────────────┬──────────┬──────────┐
    │                          │ Shell 1  │          │
    │  OMP (agent)             ├──────────┤  btop    │
    │  ~58%                    │ Shell 2  ├──────────┤
    │                          │          │ Monitor  │
    └──────────────────────────┴──────────┴──────────┘

    OMP       — agent running in podman (left, ~58%)
    Shell 1   — container shell in project dir (middle, top)
    Shell 2   — second container shell (middle, bottom)
    btop      — host resource monitor (right, top)
    Monitor   — git status + podman ps (right, bottom)

HOST CHECKS
    By default, host checks are skipped (opt-in).
    Use --check-hosts to ping all baseUrl endpoints from models.yml
    before starting. Unreachable endpoints are reported but do not
    block startup.

IMAGE
    localhost/mags-codedev-omp:latest

SESSION NAMING
    Sessions are numbered omp-1, omp-2, etc. Killed sessions leave
    gaps that get reused (e.g. killing omp-1 makes the next session
    omp-1, not omp-3).

EXAMPLES
    omp-workspace                      continue or create
    omp-workspace --new ~/proj         new session in ~/proj
    omp-workspace --attach omp-2       attach to specific session
    omp-workspace --check-hosts        ping model servers first
    omp-workspace --list               show sessions
    omp-workspace --kill omp-1         kill session + container
EOF
}

# ── Parse arguments ──────────────────────────────────────────────────
ACTION="continue"
DIR=""
TARGET=""
ATTACH=""
CHECK_HOSTS="false"

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)                 show_help; exit 0 ;;
        --list|-l)                 show_list; exit 0 ;;
        --continue|-c)             ACTION="continue"; shift ;;
        --new|-n)                  ACTION="new"; shift ;;
        --check-hosts)             CHECK_HOSTS="true"; shift ;;
        --force|-f)                CHECK_HOSTS="true"; shift ;;  # legacy alias
        --skip-checks)             shift ;;  # accepted for compat, no-op (checks are opt-in now)
        --kill|-k)                 TARGET="${2:?--kill requires name}"; shift 2 ;;
        --attach|-a)               ATTACH="${2:?--attach requires name}"; shift 2 ;;
        --extra_podman_params|-e)  EXTRA_PODMAN_PARAMETERS="${2:?--extra_podman_params requires name}"; shift 2 ;;
        -*)                        die "Unknown: $1 (--help)" ;;
        *)                         DIR="$1"; shift ;;
    esac
done

# ── Kill target ──────────────────────────────────────────────────────
if [ -n "$TARGET" ]; then
    kill_session "$TARGET"
    exit 0
fi

# ── Attach to specific session ───────────────────────────────────────
if [ -n "$ATTACH" ]; then
    if tmux has-session -t "$ATTACH" 2>/dev/null; then
        tmux attach -t "$ATTACH"
    else
        die "Session not found: $ATTACH (use --list to see active)"
    fi
    exit 0
fi

# ── Preflight ────────────────────────────────────────────────────────
count=$(session_count)

# Only check models config / endpoints when creating a new session
if [ "$ACTION" = "new" ] || [ "$count" -eq 0 ]; then
    echo "Pre-flight checks..."
    echo ""
    check_models_config

    if [ "$CHECK_HOSTS" = "true" ]; then
        check_endpoints
    else
        ok "Host checks skipped (use --check-hosts to enable)"
    fi
fi

# ── Main ─────────────────────────────────────────────────────────────
if [ "$ACTION" = "new" ]; then
    create_session "$DIR"
elif [ "$count" -eq 0 ]; then
    create_session "$DIR"
elif [ "$count" -eq 1 ]; then
    name=$(active_sessions | head -1)
    tmux attach -t "$name"
else
    echo "Multiple sessions active ($count):"
    active_sessions | nl
    echo ""
    echo "Attaching to first. Use --list to see all, --kill to remove."
    name=$(active_sessions | head -1)
    tmux attach -t "$name"
fi
