#!/usr/bin/env bash
set -euo pipefail

# ── Config ────────────────────────────────────────────────────────────
SESSION_PREFIX="omp"
PODMAN_IMAGE="localhost/mags-codedev-omp"
PODMAN_TAG="latest"
MONITOR_INTERVAL=5
MODELS_FILE="$HOME/.omp/agent/models.yml"

# ── Helpers ───────────────────────────────────────────────────────────
die()  { echo "Error: $*" >&2; exit 1; }
ok()   { echo "  ✓ $*"; }
warn() { echo "  ⚠ $*" >&2; }
fail() { echo "  ✗ $*" >&2; }

active_sessions() {
    tmux list-sessions 2>/dev/null | grep "^${SESSION_PREFIX}" || true
}

session_count() {
    active_sessions | wc -l
}

image_ref() {
    echo "${PODMAN_IMAGE}:${PODMAN_TAG}"
}

# ── Preflight: check models.yml ──────────────────────────────────────
check_models_config() {
    if [ ! -f "$MODELS_FILE" ]; then
        die "No models config at $MODELS_FILE"
    fi
    ok "Models config: $MODELS_FILE"
}

# ── Preflight: extract baseUrls from models.yml ──────────────────────
extract_endpoints() {
    grep 'baseUrl:' "$MODELS_FILE" | sed 's/.*baseUrl: *//; s/^"//; s/"$//' | sort -u
}

# ── Preflight: ping an endpoint ──────────────────────────────────────
ping_endpoint() {
    local url="$1"
    url="${url%/}"
    local code

    # Try {url}/models first (works if url ends with /v1)
    code=$(curl -sf -o /dev/null -w "%{http_code}" \
        --connect-timeout 3 --max-time 5 \
        "${url}/models" 2>/dev/null) || code="000"

    # If that failed, try with /v1 prefix
    if [ "$code" = "000" ]; then
        code=$(curl -sf -o /dev/null -w "%{http_code}" \
            --connect-timeout 3 --max-time 5 \
            "${url}/v1/models" 2>/dev/null) || code="000"
    fi

    if [ "$code" = "200" ]; then
        ok "  ${url}  →  HTTP ${code}"
        return 0
    elif [ "$code" = "401" ] || [ "$code" = "403" ]; then
        ok "  ${url}  →  HTTP ${code} (up, auth required)"
        return 0
    else
        fail "  ${url}  →  HTTP ${code}"
        return 1
    fi
}

# ── Preflight: check all endpoints ───────────────────────────────────
check_endpoints() {
    local force="$1"
    local endpoints
    endpoints=$(extract_endpoints)

    if [ -z "$endpoints" ]; then
        warn "No endpoints found in models config"
        return 0
    fi

    echo ""
    echo "Checking local model servers..."
    echo ""

    local failed=0
    while IFS= read -r ep; do
        [ -z "$ep" ] && continue
        if ! ping_endpoint "$ep"; then
            failed=$((failed + 1))
        fi
    done <<< "$endpoints"

    echo ""

    if [ "$failed" -gt 0 ] && [ "$force" != "true" ]; then
        fail "$failed endpoint(s) unreachable."
        echo "  Retry:  omp-workspace --force"
        exit 1
    elif [ "$failed" -gt 0 ]; then
        warn "$failed endpoint(s) unreachable (--force used, continuing)"
    else
        ok "All endpoints reachable"
    fi
}

# ── Create tmux session ──────────────────────────────────────────────
create_session() {
    local project_dir="${1:-.}"
    project_dir=$(realpath "$project_dir" 2>/dev/null || echo "$project_dir")
    [ -d "$project_dir" ] || die "Not a directory: $project_dir"

    local image=$(image_ref)

    # Session name
    local count=$(session_count)
    local name="${SESSION_PREFIX}-$((count + 1))"

    # OMP config mount
    local omp_flag=""
    if [ -d "$HOME/.omp" ]; then
        omp_flag="-v $(realpath "$HOME/.omp"):/root/.omp:z"
    fi

    echo ""
    echo "Creating ${name} → ${project_dir} [${image}]"
    echo ""

    # ── Layout: OMP (60%) | Shell (25%) | Monitor (15%) ─────────────

    # Pane 0: OMP — container ENTRYPOINT is bash, so start shell then run omp
    tmux new-session -d -s "$name" -c "$project_dir" \
        "podman run --name ${name} -it --rm --network=host ${omp_flag} ${image}"

    # Send 'omp' command to the container shell
    sleep 2
    tmux send-keys -t "${name}:0.0" "omp" Enter

    # Pane 1: Shell
    tmux split-window -h -t "${name}:0.0"

    # Pane 2: Monitor
    tmux split-window -h -t "${name}:0.1"

    # Compute absolute column widths
    local cols
    cols=$(tmux display-message -t "${name}:0.0" -p '#{window_width}')
    local c0=$((cols * 60 / 100))
    local c1=$((cols * 25 / 100))

    tmux resize-pane -t "${name}:0.0" -x "${c0}"
    tmux resize-pane -t "${name}:0.1" -x "${c1}"
    # Pane 2 auto-fills the remainder

    # Shell pane

    # Monitor pane
    tmux send-keys -t "${name}:0.2" \
        "watch -n ${MONITOR_INTERVAL} -t 'echo \"=== Git ===\"; git -C ${project_dir} status --short 2>/dev/null || echo \"no repo\"; echo; echo \"=== Podman ===\"; podman ps --format \"{{.Names}} {{.Status}}\" 2>/dev/null | head -5; echo; echo \"=== Disk ===\"; df -h / | tail -1'" \
        Enter

    # Select OMP pane
    tmux select-pane -t "${name}:0.0"

    tmux attach -t "$name"
}

# ── List sessions ────────────────────────────────────────────────────
show_list() {
    local list=$(active_sessions)
    if [ -z "$list" ]; then
        echo "No active sessions."
    else
        echo "Active sessions:"
        echo "$list"
    fi
}

# ── Kill session ─────────────────────────────────────────────────────
kill_session() {
    local target="${1:?Session name required}"
    tmux kill-session -t "$target" 2>/dev/null || die "Not found: $target"
    echo "Killed: $target"
}

# ── Help ─────────────────────────────────────────────────────────────
show_help() {
    cat << 'EOF'
omp-workspace  —  tmux manager for OMP + podman sandbox

USAGE
    omp-workspace [OPTIONS] [DIRECTORY]

OPTIONS
    --help, -h      This help
    --list, -l      Active sessions
    --continue, -c  Attach to existing (default)
    --new, -n       Create new session
    --force, -f     Skip server health checks
    --skip-checks   Alias for --force
    --kill, -k NAME Kill session

PRE-FLIGHT CHECKS
    Before starting, omp-workspace verifies:
      1. ~/.omp/agent/models.yml exists
      2. All baseUrl endpoints respond

    Failing checks block startup. Override with --force.

IMAGE
    localhost/mags-codedev-omp:latest

LAYOUT
    ┌───────────────────────────┬───────┬──────┐
    │ OMP (agent)               │ Shell │ Mon  │
    │ 60%                       │ 25%   │ 15%  │
    └───────────────────────────┴───────┴──────┘

    OMP     — agent running in podman
    Shell   — terminal in project dir
    Monitor — git status + podman ps + disk (auto-refresh)

EXAMPLES
    omp-workspace                  continue or create
    omp-workspace --new ~/proj     new session in ~/proj
    omp-workspace --force          skip endpoint checks
    omp-workspace --list           show sessions
    omp-workspace --kill omp-1     kill session
EOF
}

# ── Parse arguments ──────────────────────────────────────────────────
ACTION="continue"
DIR=""
TARGET=""
FORCE="false"

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)        show_help; exit 0 ;;
        --list|-l)        show_list; exit 0 ;;
        --continue|-c)    ACTION="continue"; shift ;;
        --new|-n)         ACTION="new"; shift ;;
        --force|-f)       FORCE="true"; shift ;;
        --skip-checks)    FORCE="true"; shift ;;
        --kill|-k)        TARGET="${2:?--kill requires name}"; shift 2 ;;
        -*)               die "Unknown: $1 (--help)" ;;
        *)                DIR="$1"; shift ;;
    esac
done

# ── Kill target ──────────────────────────────────────────────────────
if [ -n "$TARGET" ]; then
    kill_session "$TARGET"
    exit 0
fi

# ── Preflight (only when creating a new session) ─────────────────────
count=$(session_count)

if [ "$ACTION" = "new" ] || [ "$count" -eq 0 ]; then
    echo "Pre-flight checks..."
    echo ""
    check_models_config
    check_endpoints "$FORCE"
fi

# ── Main ─────────────────────────────────────────────────────────────
if [ "$ACTION" = "new" ]; then
    create_session "$DIR"
elif [ "$count" -eq 0 ]; then
    create_session "$DIR"
elif [ "$count" -eq 1 ]; then
    name=$(active_sessions | head -1 | cut -d: -f1)
    tmux attach -t "$name"
else
    echo "Multiple sessions. Use --list to see all."
    name=$(active_sessions | head -1 | cut -d: -f1)
    tmux attach -t "$name"
fi
